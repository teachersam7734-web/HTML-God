[
  { "do": "click", "sel": "#submit" },
  { "do": "wait", "ms": 250 },
  { "do": "eval", "expr": "document.getElementById('f-name').getAttribute('aria-invalid')", "expect": "true" },
  { "do": "eval", "expr": "document.activeElement.id", "expect": "f-name" },
  { "do": "eval", "expr": "document.querySelectorAll('#summary a').length", "expect": "4" },
  { "do": "text", "has": "There are 4 problems with the form" },
  { "do": "eval", "expr": "document.getElementById('status').textContent", "expect": "" },
  { "do": "shot", "name": "form-errors" },
  { "do": "fill", "sel": "#f-name", "value": "Sara Ahmadi" },
  { "do": "fill", "sel": "#f-email", "value": "not-an-email" },
  { "do": "click", "sel": "#submit" },
  { "do": "wait", "ms": 250 },
  { "do": "eval", "expr": "document.getElementById('f-email-err').textContent", "expect": "Enter an email address like name@example.com." },
  { "do": "eval", "expr": "document.getElementById('f-name').getAttribute('aria-invalid')", "expect": "false" },
  { "do": "fill", "sel": "#f-email", "value": "sara@example.com" },
  { "do": "fill", "sel": "#f-tel", "value": "۰۹۱۲ ۳۴۵ ۶۷۸۹" },
  { "do": "click", "sel": "#f-course" },
  { "do": "press", "key": "Escape" },
  { "do": "eval", "expr": "(document.getElementById('f-course').value = 'ielts', document.getElementById('f-course').dispatchEvent(new Event('change')), document.getElementById('f-course').value)", "expect": "ielts" },
  { "do": "click", "sel": "#f-ok" },
  { "do": "click", "sel": "#submit" },
  { "do": "wait", "ms": 250 },
  { "do": "eval", "expr": "document.getElementById('f-tel').value", "expect": "09123456789" },
  { "do": "text", "has": "Saved on this device only. Nothing has been sent to the school yet." },
  { "do": "eval", "expr": "location.search", "expect": "" },
  { "do": "eval", "expr": "JSON.parse(localStorage.getItem('sensei-form-entries')).length", "expect": "1" },
  { "do": "eval", "expr": "document.getElementById('mail').getAttribute('href').startsWith('mailto:school%40example.com?subject=')", "expect": "true" },
  { "do": "shot", "name": "form-saved" },
  { "do": "click", "sel": "#lang" },
  { "do": "wait", "ms": 250 },
  { "do": "eval", "expr": "document.documentElement.dir + ' ' + document.documentElement.lang", "expect": "rtl fa" },
  { "do": "text", "has": "فقط روی همین دستگاه ذخیره شد" },
  { "do": "shot", "name": "form-saved-fa" }
]
